# Copy to .env (`make env`) and replace placeholders. .env is git-ignored; never commit real values.
# Every value below is a local placeholder.

# ---- Local infrastructure (docker-compose) ----
POSTGRES_ADMIN_USER=vasmkt_admin
POSTGRES_ADMIN_PASSWORD=change-me-local-admin
SERVICE_DB_PASSWORD=change-me-local-service
REDIS_PASSWORD=change-me-local-redis
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-kc
# Password for the demo users (admin, manager, approver, analyst, data, aiops, viewer); min 12 chars.
KEYCLOAK_DEMO_USER_PASSWORD=change-me-demo-users

# ---- LocalStack (ADR-023) ----
# Required since LocalStack 2026.03; the free Hobby plan covers S3/KMS/Secrets Manager (non-commercial).
LOCALSTACK_AUTH_TOKEN=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# ---- AI providers (ADR-006) — switchable without code changes ----
# stub | anthropic | openai | bedrock | ollama
AI_PROVIDER=stub
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Bedrock uses the AWS credential chain (IRSA in EKS); only the region/model IDs are configured.
BEDROCK_REGION=us-east-1
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL_SMALL=claude-haiku-4-5
AI_MODEL_LARGE=claude-sonnet-5

# ---- ai-orchestrator (Python) ----
ORCHESTRATOR_ENVIRONMENT=local
ORCHESTRATOR_AI_GATEWAY_URL=http://localhost:8090

# ---- Terraform placeholders (plan/validate only until real values are provided) ----
TF_VAR_aws_account_id=000000000000
TF_VAR_aws_region=us-east-1
TF_VAR_environment=dev
TF_VAR_domain_name=vasmkt.example.com
TF_VAR_alert_email=platform-alerts@example.com
