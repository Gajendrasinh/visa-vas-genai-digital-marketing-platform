{
  "realm": "vasmkt",
  "enabled": true,
  "displayName": "VAS Marketing (local)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionMaxLifespan": 28800,
  "passwordPolicy": "length(12)",
  "roles": {
    "realm": [
      {
        "name": "MARKETING_ADMIN",
        "description": "Full marketing administration"
      },
      {
        "name": "CAMPAIGN_MANAGER",
        "description": "Create, approve (not own) and publish campaigns"
      },
      {
        "name": "MARKETING_ANALYST",
        "description": "Read campaigns and analytics, use the copilot"
      },
      {
        "name": "DATA_ANALYST",
        "description": "Analytics, segments, masked customer profiles"
      },
      {
        "name": "AI_OPERATOR",
        "description": "Prompts, model routing, evaluations, AI telemetry"
      },
      {
        "name": "READ_ONLY",
        "description": "Read-only access"
      }
    ]
  },
  "clients": [
    {
      "clientId": "marketing-console",
      "name": "Marketing console (SPA)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "aggregate.attrs": "false",
            "multivalued": "false"
          }
        },
        {
          "name": "vasmkt-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "vasmkt-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "vasmkt-local-cli",
      "name": "LOCAL DEVELOPMENT ONLY - password grant for scripts/tests",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "aggregate.attrs": "false",
            "multivalued": "false"
          }
        },
        {
          "name": "vasmkt-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "vasmkt-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
