<?xml version="1.0" encoding="UTF-8"?>
<!--
  Narrow, reviewed exclusions only. Every entry states why the finding is a false positive.
  Do not add broad bug-pattern or package exclusions here to make a build pass.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

  <!--
    EI_EXPOSE_REP2 on fields holding injected, thread-safe framework collaborators. These objects
    are shared singletons by design (dependency injection); copying them is impossible or would
    break their purpose. The detector stays active for all other types (e.g. collections, arrays).
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Or>
      <Field type="javax.sql.DataSource"/>
      <Field type="org.springframework.jdbc.core.JdbcTemplate"/>
      <Field type="org.springframework.transaction.support.TransactionTemplate"/>
      <Field type="org.springframework.kafka.core.KafkaTemplate"/>
      <Field type="tools.jackson.databind.ObjectWriter"/>
    </Or>
  </Match>
</FindBugsFilter>
